    {"id": "f0a-dir-zno-invalid-hkil", "op": "millerNormal", "args": {"cell": [[3.25, 0.0, 0.0], [-1.625, 2.8145825622994254, 0.0], [0.0, 0.0, 5.207]], "hkil": [1, 0, 0, 0]}, "expect": {"error": "in (h k i l), i must be −(h + k) = -1"}},
