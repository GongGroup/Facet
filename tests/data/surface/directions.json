    {"id": "f0a-dir-normal-singular-cell", "op": "millerNormal", "args": {"cell": [[1, 0, 0], [0, 1, 0], [1, 1, 0]], "hkl": [1, 0, 0]}, "expect": {"error": "cell vectors are linearly dependent"}},
