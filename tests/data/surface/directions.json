    {"id": "f0a-dir-direction-singular-cell", "op": "latticeDirection", "args": {"cell": [[1, 0, 0], [2, 0, 0], [0, 0, 1]], "uvw": [0, 0, 1]}, "expect": {"error": "cell vectors are linearly dependent"}},
