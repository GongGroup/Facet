    {
      "id": "recipe-crystal-poscar-no-flags",
      "note": "a structure without constraints is written without a Selective dynamics line",
      "op": "write",
      "args": {
        "format": "poscar"
      },
      "input": {
        "recipe": {
          "name": "crystal",
          "args": {
            "prototype": "fcc",
            "elements": ["Pt"],
            "a": 3.92
          }
        }
      },
      "expect": {
        "text": {
          "contains": ["Pt", "Direct"],
          "excludes": ["Selective dynamics"]
        }
      }
    },
