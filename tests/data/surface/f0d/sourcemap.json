{
  "schema": "crystallume.cases/1",
  "description": "F0-D T1/T2: source maps and change-tracking sessions (crystallume/core/structure.py, web/js/core/structure.js; F0-D 3.4, ledger L-F0-04): the six ways of editing (in place, delete then derive, derive then delete, several levels, derive then edit the parent, copy then sort), unrelated structures, _adopt, _set_source/setSource, concat, extend and frames; the maps of single edits; invert_source_map and compose_source_maps. Every input atom has a unique label, so a map can be checked against the labels it produces. Expectations are written by hand.",
  "cases": [
    {"id": "f0d-srcmap-in-place-delete-then-append", "op": "trackEdit", "args": {"steps": [{"do": "delete", "indices": [0]}, {"do": "append", "symbol": "O", "position": [0, 0, 5]}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [1, 2, -1], "structure": {"props": {"labels": ["Pt1", "O2", "O"]}}, "maps": {"work": [1, 2, -1]}}, "note": "F0-D 3.4: the six ways of editing give the map that matches the atoms' labels, in both languages"},
    {"id": "f0d-srcmap-delete-then-derive", "op": "trackEdit", "args": {"steps": [{"do": "delete", "indices": [0]}, {"do": "repeat", "reps": [2, 1, 1], "as": "r"}], "result": "r"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [1, 2, 1, 2], "structure": {"props": {"labels": ["Pt1", "O2", "Pt1", "O2"]}}, "maps": {"work": [1, 2], "r": [0, 1, 0, 1]}}, "note": "r's own source map refers to work as it was when r was made"},
    {"id": "f0d-srcmap-derive-then-delete", "op": "trackEdit", "args": {"steps": [{"do": "repeat", "reps": [2, 1, 1], "as": "r"}, {"do": "delete", "on": "r", "indices": [0]}], "result": "r"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [1, 2, 0, 1, 2], "structure": {"props": {"labels": ["Pt1", "O2", "Pt0", "Pt1", "O2"]}}, "maps": {"work": null, "r": [1, 2, 0, 1, 2]}}, "note": "v1's 'last map only' gave [1, 2, 0, 0, 0] here (review F0-D #3)"},
    {"id": "f0d-srcmap-several-levels", "op": "trackEdit", "args": {"steps": [{"do": "delete", "indices": [1]}, {"do": "repeat", "reps": [2, 1, 1], "as": "r"}, {"do": "append", "on": "r", "symbol": "H", "position": [0, 0, 5]}, {"do": "select", "on": "r", "indices": [4, 0, 1], "as": "s"}], "result": "s"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 2, -1], "structure": {"props": {"labels": ["Pt0", "O2", "H"]}}, "maps": {"work": [0, 2], "r": [0, 1, 0, 1, -1], "s": [0, 1, 4]}}, "note": "select keeps the atoms in their order, whatever the order of the indices"},
    {"id": "f0d-srcmap-derive-then-edit-the-parent", "op": "trackEdit", "args": {"steps": [{"do": "repeat", "reps": [2, 1, 1], "as": "r"}, {"do": "delete", "indices": [0]}], "result": "r"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2, 0, 1, 2], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2", "Pt0", "Pt1", "O2"]}}, "maps": {"work": [1, 2], "r": [0, 1, 2, 0, 1, 2]}}},
    {"id": "f0d-srcmap-copy-then-sort", "op": "trackEdit", "args": {"steps": [{"do": "copy", "as": "c"}, {"do": "sortBySpecies", "on": "c"}], "result": "c"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "O", "Pt"], "positions": [[0.0, 0.0, 0.0], [0.7, 1.2, 0.0], [1.4, 0.0, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "O1", "Pt2"]}}}, "expect": {"sourceMap": [0, 2, 1], "structure": {"props": {"labels": ["Pt0", "Pt2", "O1"]}}, "maps": {"work": null, "c": [0, 2, 1]}}},
    {"id": "f0d-srcmap-unrelated-structure", "op": "trackEdit", "args": {"steps": [{"do": "new", "structure": {"schema": "crystallume.structure/1", "symbols": ["O", "Pt"], "positions": [[0.0, 0.0, 3.0], [1.0, 1.0, 3.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["O2*", "Pt0*"]}}, "as": "x"}], "result": "x"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": null, "maps": {"work": null, "x": null}}, "note": "a structure that is not derived from the tracked one has no map (editActive asks for one)"},
    {"id": "f0d-srcmap-copy-has-no-map", "op": "trackEdit", "args": {"steps": [{"do": "copy", "as": "c"}], "result": "c"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2"]}}, "maps": {"work": null, "c": null}}, "note": "copy: same atoms, source_map null; in the session it is the identity"},
    {"id": "f0d-srcmap-adopt-a-derived-structure", "op": "trackEdit", "args": {"steps": [{"do": "repeat", "reps": [2, 1, 1], "as": "r"}, {"do": "adopt", "from": "r"}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2, 0, 1, 2], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2", "Pt0", "Pt1", "O2"]}}, "maps": {"work": [0, 1, 2, 0, 1, 2], "r": [0, 1, 2, 0, 1, 2]}}, "note": "_adopt takes over r's state and composes r's map into work's"},
    {"id": "f0d-srcmap-adopt-an-unrelated-structure", "op": "trackEdit", "args": {"steps": [{"do": "new", "structure": {"schema": "crystallume.structure/1", "symbols": ["O", "Pt"], "positions": [[0.0, 0.0, 3.0], [1.0, 1.0, 3.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["O2*", "Pt0*"]}}, "as": "x"}, {"do": "adopt", "from": "x"}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": null, "structure": {"props": {"labels": ["O2*", "Pt0*"]}}, "maps": {"work": null, "x": null}}, "note": "without a map the session loses track: null"},
    {"id": "f0d-srcmap-adopt-with-a-map", "op": "trackEdit", "args": {"steps": [{"do": "new", "structure": {"schema": "crystallume.structure/1", "symbols": ["O", "Pt"], "positions": [[0.0, 0.0, 3.0], [1.0, 1.0, 3.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["O2*", "Pt0*"]}}, "as": "x"}, {"do": "adopt", "from": "x", "src": [2, 0]}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [2, 0], "structure": {"props": {"labels": ["O2*", "Pt0*"]}}, "maps": {"work": [2, 0], "x": null}}},
    {"id": "f0d-srcmap-builder-declares-its-source", "op": "trackEdit", "args": {"steps": [{"do": "new", "structure": {"schema": "crystallume.structure/1", "symbols": ["O", "Pt"], "positions": [[0.0, 0.0, 3.0], [1.0, 1.0, 3.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["O2*", "Pt0*"]}}, "as": "x"}, {"do": "setSource", "on": "x", "parent": "work", "src": [2, -1]}], "result": "x"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [2, -1], "structure": {"props": {"labels": ["O2*", "Pt0*"]}}, "maps": {"work": null, "x": [2, -1]}}, "note": "_set_source / setSource: a builder made x from arrays, from work's atom 2 and one new atom"},
    {"id": "f0d-srcmap-concat", "op": "trackEdit", "args": {"steps": [{"do": "new", "structure": {"schema": "crystallume.structure/1", "symbols": ["H"], "positions": [[0.0, 0.0, 5.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["H*"]}}, "as": "o"}, {"do": "concat", "parts": ["work", "o"], "as": "c"}], "result": "c"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2, -1], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2", "H*"]}}, "maps": {"work": null, "o": null, "c": [0, 1, 2, -1]}}},
    {"id": "f0d-srcmap-extend", "op": "trackEdit", "args": {"steps": [{"do": "new", "structure": {"schema": "crystallume.structure/1", "symbols": ["H"], "positions": [[0.0, 0.0, 5.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["H*"]}}, "as": "o"}, {"do": "extend", "other": "o"}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2, -1], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2", "H*"]}}, "maps": {"work": [0, 1, 2, -1], "o": null}}},
    {"id": "f0d-srcmap-select-by-element", "op": "trackEdit", "args": {"steps": [{"do": "select", "elements": ["O"], "as": "s"}], "result": "s"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [2], "structure": {"props": {"labels": ["O2"]}}, "maps": {"work": null, "s": [2]}}},
    {"id": "f0d-srcmap-remap-step", "op": "trackEdit", "args": {"steps": [{"do": "remap", "src": [2, -1, 1], "newSymbols": ["H"], "newPositions": [[0, 0, 3]]}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [2, -1, 1], "structure": {"props": {"labels": ["O2", "H", "Pt1"]}}, "maps": {"work": [2, -1, 1]}}},
    {"id": "f0d-srcmap-get-frame", "op": "trackEdit", "args": {"steps": [{"do": "getFrame", "index": 1, "as": "f"}, {"do": "keepFrame", "index": 1}], "result": "f"}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "frames": [{"positions": [[0, 0, 0.1], [1.4, 0, 0.1], [0.7, 1.2, 0.1]]}], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2"]}}, "maps": {"work": null, "f": null}}, "note": "frames keep the atoms: no map, identity in the session"},
    {"id": "f0d-srcmap-keep-frame", "op": "trackEdit", "args": {"steps": [{"do": "keepFrame", "index": 1}]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "frames": [{"positions": [[0, 0, 0.1], [1.4, 0, 0.1], [0.7, 1.2, 0.1]]}], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 1, 2], "structure": {"props": {"labels": ["Pt0", "Pt1", "O2"]}}, "maps": {"work": null}}},
    {"id": "f0d-srcmap-delete-negative-and-repeated-indices", "op": "delete", "args": {"indices": [-1, 0, 0]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"structure": {"symbols": ["Pt"], "props": {"labels": ["Pt1"]}}, "sourceMap": [1]}, "note": "-1 is the last atom; an index given twice deletes one atom"},
    {"id": "f0d-srcmap-delete-out-of-range", "op": "delete", "args": {"indices": [3]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"error": "atom index 3 out of range (structure has 3 atoms)"}, "note": "before F0-D an index past the end was taken modulo n"},
    {"id": "f0d-srcmap-delete-out-of-range-negative", "op": "delete", "args": {"indices": [-4]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"error": "atom index -4 out of range (structure has 3 atoms)"}},
    {"id": "f0d-srcmap-delete-nothing", "op": "delete", "args": {"indices": []}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"structure": {"symbols": ["Pt", "Pt", "O"]}, "sourceMap": null}},
    {"id": "f0d-srcmap-select-keeps-the-order", "op": "select", "args": {"indices": [2, 0]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"structure": {"props": {"labels": ["Pt0", "O2"]}}, "sourceMap": [0, 2]}},
    {"id": "f0d-srcmap-select-mask", "op": "select", "args": {"mask": [true, false, true]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [0, 2]}},
    {"id": "f0d-srcmap-select-and", "op": "select", "args": {"elements": "Pt", "indices": [1, 2]}, "input": {"structure": {"schema": "crystallume.structure/1", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0], [0.7, 1.2, 0.0]], "cell": [[2.8, 0.0, 0.0], [0.0, 2.4, 0.0], [0.0, 0.0, 10.0]], "pbc": [true, true, true], "props": {"labels": ["Pt0", "Pt1", "O2"]}}}, "expect": {"sourceMap": [1]}},
