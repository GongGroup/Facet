{
  "schema": "crystallume.cases/1",
  "description": "F0-D T6: the export check (crystallume/io/__init__.py export_report, web/js/io/index.js exportReport): the writer capability table and its validation (F0-D 3.12.1), each rule W1-W11, N1, N2 and the velocities note of lead decision L-01 with a case where it applies and one where it does not, the order of the messages, and close_contacts / closeContacts (3.12.3). Expectations are written by hand (the texts of F0-D 3.12.2 and ledger L-F0-25).",
  "cases": [
    {"id": "f0d-export-capability-table", "op": "writerCapabilities", "expect": {"value": {"table": {"json": {"label": "Crystallume JSON", "frames": "all", "cell": true, "constraints": "lattice", "occupancy": true, "order": "keep", "pbc": "stored", "overlap": false, "handedness": false, "velocities": true}, "extxyz": {"label": "Extended XYZ", "frames": "all", "cell": true, "constraints": "cartesian", "occupancy": true, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": true}, "xyz": {"label": "plain XYZ", "frames": "all", "cell": false, "constraints": "none", "occupancy": false, "order": "keep", "pbc": "none", "overlap": false, "handedness": false, "velocities": false}, "poscar": {"label": "POSCAR", "frames": "one", "cell": "required", "constraints": "lattice", "occupancy": false, "order": "species", "pbc": "periodic", "overlap": true, "handedness": true, "velocities": true}, "cif": {"label": "CIF", "frames": "one", "cell": "required", "constraints": "none", "occupancy": true, "order": "keep", "pbc": "periodic", "overlap": true, "handedness": false, "velocities": false}, "pdb": {"label": "PDB", "frames": "all", "cell": true, "constraints": "none", "occupancy": false, "order": "keep", "pbc": "periodic", "overlap": false, "handedness": false, "velocities": false}}, "keys": ["label", "frames", "cell", "constraints", "occupancy", "order", "pbc", "overlap", "handedness", "velocities"], "overlapCheckMaxAtoms": 200000, "occupancyTolerance": 1e-06}}, "note": "F0-D 3.12.1, ledger L-F0-25, plus the velocities column of lead decision L-01; the same in both languages"},
    {"id": "f0d-export-validate-ok", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": "My format", "frames": "one", "cell": true, "constraints": "cartesian", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}, "expect": {"value": {"label": "My format", "frames": "one", "cell": true, "constraints": "cartesian", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}},
    {"id": "f0d-export-validate-bad-constraints", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": "My format", "frames": "one", "cell": true, "constraints": "yes", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}, "expect": {"error": "writer 'myfmt': capabilities.constraints must be one of lattice, cartesian, none"}, "note": "the message of F0-D 3.12.1 (engineering review #24)"},
    {"id": "f0d-export-validate-missing-key", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": "My format", "cell": true, "constraints": "cartesian", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}, "expect": {"error": "writer 'myfmt': capabilities.frames must be one of all, one"}},
    {"id": "f0d-export-validate-unknown-key", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": "My format", "frames": "one", "cell": true, "constraints": "cartesian", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false, "constraint": "none"}}, "expect": {"error": "writer 'myfmt': unknown capability 'constraint' (known: label, frames, cell, constraints, occupancy, order, pbc, overlap, handedness, velocities)"}},
    {"id": "f0d-export-validate-number-is-not-a-bool", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": "My format", "frames": "one", "cell": true, "constraints": "cartesian", "occupancy": 1, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}, "expect": {"error": "writer 'myfmt': capabilities.occupancy must be true or false"}},
    {"id": "f0d-export-validate-cell-values", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": "My format", "frames": "one", "cell": "yes", "constraints": "cartesian", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}, "expect": {"error": "writer 'myfmt': capabilities.cell must be one of true, false, required"}},
    {"id": "f0d-export-validate-empty-label", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": {"label": " ", "frames": "one", "cell": true, "constraints": "cartesian", "occupancy": false, "order": "keep", "pbc": "stored", "overlap": true, "handedness": false, "velocities": false}}, "expect": {"error": "writer 'myfmt': capabilities.label must be a non-empty string"}},
    {"id": "f0d-export-validate-not-an-object", "op": "validateCapabilities", "args": {"name": "myfmt", "caps": [1, 2]}, "expect": {"error": "writer 'myfmt': capabilities must be an object with the keys label, frames, cell, constraints, occupancy, order, pbc, overlap, handedness, velocities"}},
    {"id": "f0d-export-w1-poscar-trajectory", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "frames": [{"positions": [[0.0, 0.0, 1.1], [1.5, 1.5, 3.1]]}]}}, "expect": {"warnings": {"equals": ["POSCAR holds one frame: wrote frame 1 of 2"]}, "notes": []}, "note": "F0-D 3.12.2 W1 and defect E-25: the frame written is named (Python frame 0, JS the current frame)"},
    {"id": "f0d-export-w1-poscar-second-frame", "op": "exportReport", "args": {"format": "poscar", "frame": 1}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "frames": [{"positions": [[0.0, 0.0, 1.1], [1.5, 1.5, 3.1]]}]}}, "expect": {"warnings": {"equals": ["POSCAR holds one frame: wrote frame 2 of 2"]}, "notes": []}},
    {"id": "f0d-export-w1-poscar-last-frame", "op": "exportReport", "args": {"format": "poscar", "frame": -1}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "frames": [{"positions": [[0.0, 0.0, 1.1], [1.5, 1.5, 3.1]]}]}}, "expect": {"warnings": {"equals": ["POSCAR holds one frame: wrote frame 2 of 2"]}, "notes": []}},
    {"id": "f0d-export-w1-cif-trajectory", "op": "exportReport", "args": {"format": "cif"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "frames": [{"positions": [[0.0, 0.0, 1.1], [1.5, 1.5, 3.1]]}]}}, "expect": {"warnings": {"equals": ["CIF holds one frame: wrote frame 1 of 2"]}, "notes": []}},
    {"id": "f0d-export-w1-negative-one-frame", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true]}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w1-negative-extxyz-all-frames", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "frames": [{"positions": [[0.0, 0.0, 1.1], [1.5, 1.5, 3.1]]}]}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w2-xyz-cell", "op": "exportReport", "args": {"format": "xyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true]}}, "expect": {"warnings": {"equals": ["plain XYZ does not store the unit cell; use Extended XYZ to keep it"]}, "notes": []}},
    {"id": "f0d-export-w2-negative-molecule", "op": "exportReport", "args": {"format": "xyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["O", "H", "H"], "positions": [[0.0, 0.0, 0.0], [0.0, 0.757, 0.586], [0.0, -0.757, 0.586]], "cell": null, "pbc": [false, false, false]}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w2-negative-extxyz", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true]}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w3-poscar-without-cell", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["O", "H", "H"], "positions": [[0.0, 0.0, 0.0], [0.0, 0.757, 0.586], [0.0, -0.757, 0.586]], "cell": null, "pbc": [false, false, false]}}, "expect": {"warnings": {"equals": ["POSCAR needs a unit cell: the atoms were placed in a box with 10 Å of vacuum on each side (20 Å between periodic images)"]}, "notes": []}, "skip": {"js": "F0-D O-2 is not done: the web POSCAR and CIF writers refuse a structure without a cell, so the web export check has no W3"}, "note": "the Python POSCAR writer boxes the atoms (Structure.center(vacuum=10))"},
    {"id": "f0d-export-w3-cif-without-cell", "op": "exportReport", "args": {"format": "cif"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["O", "H", "H"], "positions": [[0.0, 0.0, 0.0], [0.0, 0.757, 0.586], [0.0, -0.757, 0.586]], "cell": null, "pbc": [false, false, false]}}, "expect": {"warnings": {"equals": ["CIF needs a unit cell: the atoms were placed in a box with 10 Å of vacuum on each side (20 Å between periodic images)"]}, "notes": []}, "skip": {"js": "F0-D O-2 is not done: the web POSCAR and CIF writers refuse a structure without a cell, so the web export check has no W3"}},
    {"id": "f0d-export-w4-cif-fixed", "op": "exportReport", "args": {"format": "cif"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0], [0.0, 0.0, 5.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, false, false], [true, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": ["2 atom(s) are fixed or partly fixed (selective dynamics), but CIF cannot store constraints; use POSCAR, Extended XYZ or Crystallume JSON to keep them"]}, "notes": []}, "note": "1 F F F and 1 T T F atom"},
    {"id": "f0d-export-w4-pdb-fixed", "op": "exportReport", "args": {"format": "pdb"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0], [0.0, 0.0, 5.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, false, false], [true, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": ["2 atom(s) are fixed or partly fixed (selective dynamics), but PDB cannot store constraints; use POSCAR, Extended XYZ or Crystallume JSON to keep them"]}, "notes": []}},
    {"id": "f0d-export-w4-xyz-fixed", "op": "exportReport", "args": {"format": "xyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0], [0.0, 0.0, 5.0]], "cell": null, "pbc": [false, false, false], "props": {"selective_dynamics": [[false, false, false], [true, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": ["2 atom(s) are fixed or partly fixed (selective dynamics), but plain XYZ cannot store constraints; use POSCAR, Extended XYZ or Crystallume JSON to keep them"]}, "notes": []}},
    {"id": "f0d-export-w4-negative-all-free", "op": "exportReport", "args": {"format": "cif"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0], [0.0, 0.0, 5.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[true, true, true], [true, true, true], [true, true, true]]}}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w4-negative-poscar-keeps-them", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0], [0.0, 0.0, 5.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, false, false], [true, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": []}, "notes": []}, "note": "no N1: Pt Pt O is grouped already"},
    {"id": "f0d-export-w4-negative-json-keeps-them", "op": "exportReport", "args": {"format": "json"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0], [0.0, 0.0, 5.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, false, false], [true, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w5-extxyz-hex-along-b", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt"], "positions": [[0.0, 0.0, 1.0], [1.385, 0.79963, 3.26]], "cell": [[2.77, 0.0, 0.0], [-1.385, 2.39889, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": ["Extended XYZ stores constraints along x, y and z (ASE move_mask): the partial constraints of 1 atom(s) are along cell vectors that are not x, y or z and were tightened; POSCAR keeps them exactly"]}, "notes": []}, "note": "free along b only, on a hexagonal cell: no Cartesian form, written fixed; the mask is then one column (no W6)"},
    {"id": "f0d-export-w5-negative-ortho-along-b", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, true, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": ["Extended XYZ stores these constraints as ASE FixCartesian masks because 1 atom(s) are only partly fixed; ASE's VASP writer ignores FixCartesian and would write every atom as free, so export POSCAR from Crystallume for VASP"]}, "notes": []}, "note": "b is along y: exact, but the mask needs three columns"},
    {"id": "f0d-export-w6-extxyz-hex-ttf", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt"], "positions": [[0.0, 0.0, 1.0], [1.385, 0.79963, 3.26]], "cell": [[2.77, 0.0, 0.0], [-1.385, 2.39889, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[true, true, false], [false, false, false]]}}}, "expect": {"warnings": {"equals": ["Extended XYZ stores these constraints as ASE FixCartesian masks because 1 atom(s) are only partly fixed; ASE's VASP writer ignores FixCartesian and would write every atom as free, so export POSCAR from Crystallume for VASP"]}, "notes": []}, "note": "T T F is exact on a hexagonal cell with c along z"},
    {"id": "f0d-export-w6-negative-whole-atoms", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt"], "positions": [[0.0, 0.0, 1.0], [1.385, 0.79963, 3.26]], "cell": [[2.77, 0.0, 0.0], [-1.385, 2.39889, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, false, false], [true, true, true]]}}}, "expect": {"warnings": {"equals": []}, "notes": []}, "note": "fixed and free atoms only: one move_mask column (ASE FixAtoms)"},
    {"id": "f0d-export-w5-w6-negative-poscar", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "Pt"], "positions": [[0.0, 0.0, 1.0], [1.385, 0.79963, 3.26]], "cell": [[2.77, 0.0, 0.0], [-1.385, 2.39889, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"selective_dynamics": [[false, true, false], [true, true, false]]}}}, "expect": {"warnings": {"equals": []}, "notes": []}, "note": "POSCAR keeps the flags exactly"},
    {"id": "f0d-export-w7-poscar-partial-occupancy", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"occupancy": [0.5, 1.0]}}}, "expect": {"warnings": {"equals": ["1 site(s) are partially occupied, but POSCAR cannot store occupancy; they are written as full atoms"]}, "notes": []}},
    {"id": "f0d-export-w7-negative-within-tolerance", "op": "exportReport", "args": {"format": "poscar"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"occupancy": [1.0, 0.9999995]}}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w7-negative-cif-keeps-them", "op": "exportReport", "args": {"format": "cif"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"occupancy": [0.5, 1.0]}}}, "expect": {"warnings": {"equals": []}, "notes": []}},
    {"id": "f0d-export-w8-extxyz-props-not-written", "op": "exportReport", "args": {"format": "extxyz"}, "input": {"structure": {"schema": "crystallume.structure/1", "name": "test", "symbols": ["Pt", "O"], "positions": [[0.0, 0.0, 1.0], [1.5, 1.5, 3.0]], "cell": [[3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 20.0]], "pbc": [true, true, true], "props": {"mixed": [1, "a b"], "ragged": [[1, 2], [3]]}}}, "expect": {"warnings": {"equals": ["property 'mixed' was not written: its values are not all numbers, booleans or single words", "property 'ragged' was not written: its rows have different lengths"]}, "notes": []}},
