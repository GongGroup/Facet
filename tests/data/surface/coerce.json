{
  "schema": "crystallume.cases/1",
  "description": "F0-A T8 parameter schema (crystallume/core/params.py, web/js/core/params.js): parseIndices (JSON, brackets, ';' rows, U+2212 and the bars formatIndices writes, fractions, finite numbers), text through a type (parse_cli_value on the Python side, the controls' parse on the JS side), coerceParam on JSON values (every message of F0-A §3.15 at least once), validateParams (defaults, required, strict unknown keys, soft warnings) and defaultParams. Includes the 25 inputs of parse2.py and the 13 of params_proto.py. Expected values are written by hand from the specification (analytic). Ops: tests/ops/f0a_params.py and tests/js/ops/f0a_params.mjs.",
  "cases": [
    {"id": "f0a-params-parse-brackets-no-comma", "op": "parseIndices", "args": {"text": "[1 1 0]"}, "expect": {"value": [1, 1, 0]}, "note": "starts with [ but has no comma: not JSON; the brackets are dropped"},
    {"id": "f0a-params-parse-braces", "op": "parseIndices", "args": {"text": "{1 1 1}"}, "expect": {"value": [1, 1, 1]}},
    {"id": "f0a-params-parse-json", "op": "parseIndices", "args": {"text": "[1, 1, 1]"}, "expect": {"value": [1, 1, 1]}},
    {"id": "f0a-params-parse-json-rows", "op": "parseIndices", "args": {"text": "[[2,1],[-1,1]]"}, "expect": {"value": [[2, 1], [-1, 1]]}},
    {"id": "f0a-params-parse-json-braces-not-json", "op": "parseIndices", "args": {"text": "{1, 1, 1}"}, "expect": {"value": [1, 1, 1]}, "note": "{ and a comma, but not valid JSON: read as text"},
    {"id": "f0a-params-parse-mixed-brackets", "op": "parseIndices", "args": {"text": "[1 1 1)"}, "expect": {"value": [1, 1, 1]}, "note": "one pair of outer brackets of any kind"},
    {"id": "f0a-params-parse-commas", "op": "parseIndices", "args": {"text": "1,0,-1,0"}, "expect": {"value": [1, 0, -1, 0]}},
    {"id": "f0a-params-parse-comma-space", "op": "parseIndices", "args": {"text": "0.5, 0.5, 0"}, "expect": {"value": [0.5, 0.5, 0]}},
    {"id": "f0a-params-parse-u2212", "op": "parseIndices", "args": {"text": "1 0 −1 0"}, "expect": {"value": [1, 0, -1, 0]}, "note": "U+2212 is a minus sign"},
    {"id": "f0a-params-parse-overline", "op": "parseIndices", "args": {"text": "(1 0 1\u0305 0)"}, "expect": {"value": [1, 0, -1, 0]}, "note": "formatIndices([1, 0, -1, 0])"},
    {"id": "f0a-params-parse-macron", "op": "parseIndices", "args": {"text": "(1\u0304 0 0)"}, "expect": {"value": [-1, 0, 0]}, "note": "U+0304 counts as a bar too"},
    {"id": "f0a-params-parse-overline-multidigit", "op": "parseIndices", "args": {"text": "(1\u03052\u0305 3 9)"}, "expect": {"value": [-12, 3, 9]}, "note": "formatIndices([-12, 3, 9]) writes a bar after each digit; it reads back as -12"},
    {"id": "f0a-params-parse-overline-mixed", "op": "parseIndices", "args": {"text": "(1\u0305 1\u03050\u0305 11)"}, "expect": {"value": [-1, -10, 11]}, "note": "formatIndices([-1, -10, 11])"},
    {"id": "f0a-params-parse-overline-direction", "op": "parseIndices", "args": {"text": "[2 1\u0305 1\u0305 0]"}, "expect": {"value": [2, -1, -1, 0]}, "note": "formatIndices([2, -1, -1, 0], '[')"},
    {"id": "f0a-params-parse-overline-family", "op": "parseIndices", "args": {"text": "<1\u03051\u03052\u0305 3 0>"}, "expect": {"value": [-112, 3, 0]}, "note": "formatIndices([-112, 3, 0], '<')"},
    {"id": "f0a-params-parse-overline-partial", "op": "parseIndices", "args": {"text": "11\u0305 0 0"}, "expect": {"error": "“11\u0305” is not a number"}, "note": "a bar over only some digits of a number is not read as a sign"},
    {"id": "f0a-params-parse-double-minus", "op": "parseIndices", "args": {"text": "−1\u0305 0 0"}, "expect": {"error": "“--1” is not a number"}, "note": "a minus sign and a bar"},
    {"id": "f0a-params-parse-rows", "op": "parseIndices", "args": {"text": "2 1 0; -1 1 0; 0 0 1"}, "expect": {"value": [[2, 1, 0], [-1, 1, 0], [0, 0, 1]]}},
    {"id": "f0a-params-parse-rows-trailing", "op": "parseIndices", "args": {"text": "2 1 0; -1 1 0; 0 0 1;"}, "expect": {"value": [[2, 1, 0], [-1, 1, 0], [0, 0, 1]]}, "note": "a trailing empty row is ignored"},
    {"id": "f0a-params-parse-one-row-semicolon", "op": "parseIndices", "args": {"text": "1 1 1;"}, "expect": {"value": [[1, 1, 1]]}, "note": "';' makes rows, even one"},
    {"id": "f0a-params-parse-empty", "op": "parseIndices", "args": {"text": ""}, "expect": {"value": []}},
    {"id": "f0a-params-parse-blanks", "op": "parseIndices", "args": {"text": "  1\u00a02\u30003\t"}, "expect": {"value": [1, 2, 3]}, "note": "no-break and ideographic spaces separate numbers too"},
    {"id": "f0a-params-parse-decimals", "op": "parseIndices", "args": {"text": "1e-3 .5 1. -2.5E2"}, "expect": {"value": [0.001, 0.5, 1, -250]}},
    {"id": "f0a-params-parse-fractions", "op": "parseIndices", "args": {"text": "1/3 2/3 0", "fractions": true}, "expect": {"value": [0.3333333333333333, 0.6666666666666666, 0]}, "tol": {"value": 1e-15}},
    {"id": "f0a-params-parse-fraction-signs", "op": "parseIndices", "args": {"text": "-1/2 +3/4 1", "fractions": true}, "expect": {"value": [-0.5, 0.75, 1]}},
    {"id": "f0a-params-parse-fractions-off", "op": "parseIndices", "args": {"text": "1/3 2/3 0"}, "expect": {"error": "“1/3” is not a number"}, "note": "p/q only with fractions"},
    {"id": "f0a-params-parse-fraction-zero", "op": "parseIndices", "args": {"text": "1/0 1 1", "fractions": true}, "expect": {"error": "“1/0” divides by zero"}},
    {"id": "f0a-params-parse-word", "op": "parseIndices", "args": {"text": "true"}, "expect": {"error": "“true” is not a number"}},
    {"id": "f0a-params-parse-nan-text", "op": "parseIndices", "args": {"text": "nan 0 0"}, "expect": {"error": "“nan” is not a number"}},
    {"id": "f0a-params-parse-nan-json", "op": "parseIndices", "args": {"text": "[NaN, 0, 0]"}, "expect": {"error": "“NaN” is not a number"}, "note": "NaN is not JSON; read as text it is not a number"},
    {"id": "f0a-params-parse-infinite", "op": "parseIndices", "args": {"text": "1e400 0 0"}, "expect": {"error": "“1e400” is not a finite number"}},
    {"id": "f0a-params-parse-infinite-json", "op": "parseIndices", "args": {"text": "[1e400, 0, 0]"}, "expect": {"error": "“1e400” is not a finite number"}},
    {"id": "f0a-params-parse-json-strings", "op": "parseIndices", "args": {"text": "[1, \"a\"]"}, "expect": {"error": "“\"a\"” is not a number"}, "note": "a JSON list of other things than numbers is read as text"},
    {"id": "f0a-params-parse-one-number", "op": "parseIndices", "args": {"text": "111"}, "expect": {"value": [111]}},
    {"id": "f0a-params-parse-negative-zero", "op": "parseIndices", "args": {"text": "-0 -0.0"}, "expect": {"value": [0, 0]}},
    {"id": "f0a-params-text-uvw-brackets", "op": "coerceText", "args": {"spec": {"name": "uvw", "type": "vector", "integer": true}, "text": "[1 1 0]"}, "expect": {"value": [1, 1, 0]}},
    {"id": "f0a-params-text-hkl-brackets", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "[1 1 0]"}, "expect": {"value": [1, 1, 0]}},
    {"id": "f0a-params-text-hkl-braces", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "{1 1 1}"}, "expect": {"value": [1, 1, 1]}},
    {"id": "f0a-params-text-hkl-overline", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "(1 0 1\u0305 0)"}, "expect": {"value": [1, 0, 0]}, "note": "four indices (h k i l) become (h k l)"},
    {"id": "f0a-params-text-hkl-u2212", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1 0 −1 0"}, "expect": {"value": [1, 0, 0]}},
    {"id": "f0a-params-text-shift-fractions", "op": "coerceText", "args": {"spec": {"name": "shift", "type": "vector"}, "text": "1/3 2/3 0"}, "expect": {"value": [0.3333333333333333, 0.6666666666666666, 0]}, "tol": {"value": 1e-15}, "note": "fractions for a vector of real numbers"},
    {"id": "f0a-params-text-hkl-fractions", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1/3 2/3 0"}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}, "note": "no fractions for Miller indices"},
    {"id": "f0a-params-text-hkl-mixed-brackets", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "[1 1 1)"}, "expect": {"value": [1, 1, 1]}},
    {"id": "f0a-params-text-hkl-one-number", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "111"}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-text-p2-json", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "text": "[[2,1],[-1,1]]"}, "expect": {"value": [[2, 1], [-1, 1]]}},
    {"id": "f0a-params-text-p2-flat", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "text": "2 1 -1 1"}, "expect": {"value": [[2, 1], [-1, 1]]}, "note": "n² numbers fill the rows"},
    {"id": "f0a-params-text-p2-rows", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "text": "2 1; -1 1"}, "expect": {"value": [[2, 1], [-1, 1]]}},
    {"id": "f0a-params-text-p3-rows-trailing", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "text": "2 1 0; -1 1 0; 0 0 1;"}, "expect": {"value": [[2, 1, 0], [-1, 1, 0], [0, 0, 1]]}},
    {"id": "f0a-params-text-hkl-row", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1 1 1;"}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}, "note": "a row of a matrix is not three indices"},
    {"id": "f0a-params-text-hkl-empty", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": ""}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-text-hkl-word", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "true"}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-text-v-nan", "op": "coerceText", "args": {"spec": {"name": "v", "type": "vector"}, "text": "nan 0 0"}, "expect": {"error": "v: enter three numbers, like 0 0 1."}},
    {"id": "f0a-params-text-v-nan-json", "op": "coerceText", "args": {"spec": {"name": "v", "type": "vector"}, "text": "[NaN, 0, 0]"}, "expect": {"error": "v: enter three numbers, like 0 0 1."}},
    {"id": "f0a-params-text-hkl-commas", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1,0,-1,0"}, "expect": {"value": [1, 0, 0]}},
    {"id": "f0a-params-text-hkl-1000", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "(1 0 0 0)"}, "expect": {"error": "hkl: in (h k i l), i must be −(h + k) = -1."}},
    {"id": "f0a-params-text-hkl-json", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "[1, 1, 1]"}, "expect": {"value": [1, 1, 1]}},
    {"id": "f0a-params-text-v-comma-space", "op": "coerceText", "args": {"spec": {"name": "v", "type": "vector"}, "text": "0.5, 0.5, 0"}, "expect": {"value": [0.5, 0.5, 0]}},
    {"id": "f0a-params-text-hkl-common-factor", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "2 2 2"}, "expect": {"value": [2, 2, 2]}, "note": "common factors are kept"},
    {"id": "f0a-params-text-hkl-111-commas", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1,1,1"}, "expect": {"value": [1, 1, 1]}},
    {"id": "f0a-params-text-hkl-hkil-plain", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1 0 -1 0"}, "expect": {"value": [1, 0, 0]}},
    {"id": "f0a-params-text-hkl-hkil-parens", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "(1 0 -1 0)"}, "expect": {"value": [1, 0, 0]}},
    {"id": "f0a-params-text-hkl-1000-plain", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1 0 0 0"}, "expect": {"error": "hkl: in (h k i l), i must be −(h + k) = -1."}},
    {"id": "f0a-params-text-hkl-zero", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "[0,0,0]"}, "expect": {"error": "hkl: (0 0 0) is not a plane."}},
    {"id": "f0a-params-text-hkl-decimal", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "1.5 0 0"}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-text-shift-comma-space", "op": "coerceText", "args": {"spec": {"name": "shift", "type": "vector"}, "text": "0.5, 0.5, 0"}, "expect": {"value": [0.5, 0.5, 0]}},
    {"id": "f0a-params-text-uvw-plain", "op": "coerceText", "args": {"spec": {"name": "uvw", "type": "vector", "integer": true}, "text": "1 1 0"}, "expect": {"value": [1, 1, 0]}},
    {"id": "f0a-params-text-p2-rows-proto", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "text": "2 1; -1 1"}, "expect": {"value": [[2, 1], [-1, 1]]}},
    {"id": "f0a-params-text-p3-commas", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "text": "2,1,0;-1,1,0;0,0,1"}, "expect": {"value": [[2, 1, 0], [-1, 1, 0], [0, 0, 1]]}},
    {"id": "f0a-params-text-p3-negative", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "text": "[[1,1,0],[1,-1,0],[0,0,1]]"}, "expect": {"error": "P: the determinant is -2; a negative determinant mirrors the cell. Swap two rows or negate one."}, "note": "det = 1·(−1) − 1·1 = −2"},
    {"id": "f0a-params-text-p3-positive", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "text": "[[1,1,0],[1,-1,0],[0,0,-1]]"}, "expect": {"value": [[1, 1, 0], [1, -1, 0], [0, 0, -1]]}, "note": "det = 1·1 − 1·(−1) = 2"},
    {"id": "f0a-params-text-p2-singular", "op": "coerceText", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "text": "1 2; 2 4"}, "expect": {"error": "P: the matrix is singular (determinant 0)."}},
    {"id": "f0a-params-text-hkl-formatted-multidigit", "op": "coerceText", "args": {"spec": {"name": "hkl", "type": "miller"}, "text": "(1\u03052\u0305 1\u03051\u0305 23 4)"}, "expect": {"value": [-12, -11, 4]}, "note": "(−12 −11 23 4): i = 23 = −(h + k)"},
    {"id": "f0a-params-text-uvw-overline", "op": "coerceText", "args": {"spec": {"name": "uvw", "type": "vector", "integer": true}, "text": "[1\u0305 1 0]"}, "expect": {"value": [-1, 1, 0]}},
    {"id": "f0a-params-coerce-int-string", "op": "coerceParam", "args": {"spec": {"name": "n", "type": "int"}, "value": "4"}, "expect": {"error": "n: enter a number."}, "note": "a string is never a number here"},
    {"id": "f0a-params-coerce-int-bool", "op": "coerceParam", "args": {"spec": {"name": "n", "type": "int"}, "value": true}, "expect": {"error": "n: enter a number."}},
    {"id": "f0a-params-coerce-int-whole-float", "op": "coerceParam", "args": {"spec": {"name": "n", "type": "int"}, "value": 2.0}, "expect": {"value": 2}},
    {"id": "f0a-params-coerce-int-fraction", "op": "coerceParam", "args": {"spec": {"name": "n", "type": "int"}, "value": 2.5}, "expect": {"error": "n: enter a whole number."}},
    {"id": "f0a-params-coerce-int-range", "op": "coerceParam", "args": {"spec": {"name": "n", "type": "int", "label": "Atoms", "min": 1, "max": 10000}, "value": 0}, "expect": {"error": "Atoms: use a value from 1 to 10000."}},
    {"id": "f0a-params-coerce-int-in-range", "op": "coerceParam", "args": {"spec": {"name": "n", "type": "int", "label": "Atoms", "min": 1, "max": 10000}, "value": 10000}, "expect": {"value": 10000}},
    {"id": "f0a-params-coerce-float-min-only", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float", "min": 0.5}, "value": 0.25}, "expect": {"error": "x: use a value from 0.5 to ∞."}},
    {"id": "f0a-params-coerce-float-max-only", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float", "max": 5}, "value": 6}, "expect": {"error": "x: use a value from −∞ to 5."}},
    {"id": "f0a-params-coerce-float-negative-bound", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float", "min": -5, "max": 5}, "value": -6}, "expect": {"error": "x: use a value from -5 to 5."}, "note": "a bound is a number: ASCII minus"},
    {"id": "f0a-params-coerce-float-big-bound", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float", "max": 1e+21}, "value": 2e+21}, "expect": {"error": "x: use a value from −∞ to 1e+21."}, "note": "numbers are written as JavaScript prints them"},
    {"id": "f0a-params-coerce-float-small-bound", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float", "max": 1e-07}, "value": 1}, "expect": {"error": "x: use a value from −∞ to 1e-7."}},
    {"id": "f0a-params-coerce-float-million-bound", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float", "max": 1000000.0}, "value": 2000000.0}, "expect": {"error": "x: use a value from −∞ to 1000000."}},
    {"id": "f0a-params-coerce-float-list", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float"}, "value": [1]}, "expect": {"error": "x: enter a number."}},
    {"id": "f0a-params-coerce-float-ok", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float"}, "value": 0.25}, "expect": {"value": 0.25}},
    {"id": "f0a-params-coerce-null-optional", "op": "coerceParam", "args": {"spec": {"name": "x", "type": "float"}, "value": null}, "expect": {"value": null}},
    {"id": "f0a-params-coerce-null-required", "op": "coerceParam", "args": {"spec": {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "unit": "Å", "required": true}, "value": null}, "expect": {"error": "Vacuum: enter a value."}, "note": "U4: no default vacuum"},
    {"id": "f0a-params-coerce-required-zero", "op": "coerceParam", "args": {"spec": {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "required": true}, "value": 0}, "expect": {"value": 0}, "note": "U4: 0 is allowed"},
    {"id": "f0a-params-coerce-bool-number", "op": "coerceParam", "args": {"spec": {"name": "b", "type": "bool"}, "value": 1}, "expect": {"error": "b: use true or false."}},
    {"id": "f0a-params-coerce-bool-ok", "op": "coerceParam", "args": {"spec": {"name": "b", "type": "bool"}, "value": false}, "expect": {"value": false}},
    {"id": "f0a-params-coerce-string-number", "op": "coerceParam", "args": {"spec": {"name": "s", "type": "string"}, "value": 5}, "expect": {"error": "s: enter text."}},
    {"id": "f0a-params-coerce-string-required-empty", "op": "coerceParam", "args": {"spec": {"name": "s", "type": "string", "required": true}, "value": ""}, "expect": {"error": "s: enter a value."}},
    {"id": "f0a-params-coerce-string-empty", "op": "coerceParam", "args": {"spec": {"name": "s", "type": "string"}, "value": ""}, "expect": {"value": ""}},
    {"id": "f0a-params-coerce-element-case", "op": "coerceParam", "args": {"spec": {"name": "e", "type": "element"}, "value": " cu "}, "expect": {"value": "Cu"}},
    {"id": "f0a-params-coerce-element-upper", "op": "coerceParam", "args": {"spec": {"name": "e", "type": "element"}, "value": "FE"}, "expect": {"value": "Fe"}},
    {"id": "f0a-params-coerce-element-dummy", "op": "coerceParam", "args": {"spec": {"name": "e", "type": "element", "label": "Element"}, "value": "X"}, "expect": {"error": "Element: enter an element symbol, like Cu."}},
    {"id": "f0a-params-coerce-element-label", "op": "coerceParam", "args": {"spec": {"name": "e", "type": "element"}, "value": "Fe2"}, "expect": {"error": "e: enter an element symbol, like Cu."}},
    {"id": "f0a-params-coerce-element-number", "op": "coerceParam", "args": {"spec": {"name": "e", "type": "element"}, "value": 26}, "expect": {"error": "e: enter an element symbol, like Cu."}},
    {"id": "f0a-params-coerce-select-missing", "op": "coerceParam", "args": {"spec": {"name": "s", "type": "select", "options": [1, 2, [3, "three"]]}, "value": 4}, "expect": {"error": "s: use one of 1, 2, 3."}},
    {"id": "f0a-params-coerce-select-number", "op": "coerceParam", "args": {"spec": {"name": "s", "type": "select", "options": [1, 2]}, "value": 2.0}, "expect": {"value": 2}},
    {"id": "f0a-params-coerce-select-strings", "op": "coerceParam", "args": {"spec": {"name": "kind", "type": "select", "options": ["fcc", "bcc"]}, "value": "hcp"}, "expect": {"error": "kind: use one of fcc, bcc."}},
    {"id": "f0a-params-coerce-select-objects", "op": "coerceParam", "args": {"spec": {"name": "kind", "type": "select", "options": [{"value": "a", "label": "A"}, {"value": "b"}]}, "value": "b"}, "expect": {"value": "b"}},
    {"id": "f0a-params-coerce-select-type-strict", "op": "coerceParam", "args": {"spec": {"name": "s", "type": "select", "options": ["1", "2"]}, "value": 1}, "expect": {"error": "s: use one of 1, 2."}, "note": "the number 1 is not the string '1'"},
    {"id": "f0a-params-coerce-unknown-type", "op": "coerceParam", "args": {"spec": {"name": "c", "type": "color"}, "value": "#fff"}, "expect": {"value": "#fff"}, "note": "types the schema does not know pass unchanged"},
    {"id": "f0a-params-coerce-vector-ok", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector"}, "value": [0.5, 0.5, 0]}, "expect": {"value": [0.5, 0.5, 0]}},
    {"id": "f0a-params-coerce-vector-short", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector"}, "value": [1, 2]}, "expect": {"error": "v: enter three numbers, like 0 0 1."}},
    {"id": "f0a-params-coerce-vector-not-numbers", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector"}, "value": [1, "a", 0]}, "expect": {"error": "v: enter three numbers, like 0 0 1."}},
    {"id": "f0a-params-coerce-vector-infinite", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector"}, "value": [1e400, 0, 0]}, "expect": {"error": "v: enter three numbers, like 0 0 1."}, "note": "1e400 is read as infinity: not a finite number"},
    {"id": "f0a-params-coerce-vector-zero", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector", "nonzero": true}, "value": [0, 0, 0]}, "expect": {"error": "v: the vector cannot be zero."}},
    {"id": "f0a-params-coerce-vector-zero-allowed", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector"}, "value": [0, 0, 0]}, "expect": {"value": [0, 0, 0]}},
    {"id": "f0a-params-coerce-vector-integer", "op": "coerceParam", "args": {"spec": {"name": "uvw", "type": "vector", "integer": true}, "value": [1, 1.5, 0]}, "expect": {"error": "uvw: enter three whole numbers, like 1 1 0."}},
    {"id": "f0a-params-coerce-vector-integer-ok", "op": "coerceParam", "args": {"spec": {"name": "uvw", "type": "vector", "integer": true}, "value": [2.0, -1, 0]}, "expect": {"value": [2, -1, 0]}},
    {"id": "f0a-params-coerce-vector-size2", "op": "coerceParam", "args": {"spec": {"name": "uv", "type": "vector", "size": 2}, "value": [1, 2, 3]}, "expect": {"error": "uv: enter two numbers, like 0.5 0.5."}},
    {"id": "f0a-params-coerce-vector-size2-ok", "op": "coerceParam", "args": {"spec": {"name": "uv", "type": "vector", "size": 2}, "value": [0.25, 0.5]}, "expect": {"value": [0.25, 0.5]}},
    {"id": "f0a-params-coerce-vector-size2-integer", "op": "coerceParam", "args": {"spec": {"name": "uv", "type": "vector", "size": 2, "integer": true}, "value": [0.5, 1]}, "expect": {"error": "uv: enter two whole numbers, like 1 0."}},
    {"id": "f0a-params-coerce-vector-string", "op": "coerceParam", "args": {"spec": {"name": "v", "type": "vector"}, "value": "0 0 1"}, "expect": {"error": "v: enter three numbers, like 0 0 1."}, "note": "text goes through parseIndices first"},
    {"id": "f0a-params-coerce-miller-hkil", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [1, 0, -1, 0]}, "expect": {"value": [1, 0, 0]}},
    {"id": "f0a-params-coerce-miller-hkil-negative", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [-1, -1, 2, 0]}, "expect": {"value": [-1, -1, 0]}},
    {"id": "f0a-params-coerce-miller-hkil-wrong", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [2, 1, -4, 0]}, "expect": {"error": "hkl: in (h k i l), i must be −(h + k) = -3."}},
    {"id": "f0a-params-coerce-miller-hkil-1000", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [1, 0, 0, 0]}, "expect": {"error": "hkl: in (h k i l), i must be −(h + k) = -1."}},
    {"id": "f0a-params-coerce-miller-zero", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [0, 0, 0]}, "expect": {"error": "hkl: (0 0 0) is not a plane."}},
    {"id": "f0a-params-coerce-miller-zero-hkil", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [0, 0, 0, 0]}, "expect": {"error": "hkl: (0 0 0) is not a plane."}},
    {"id": "f0a-params-coerce-miller-hard-limit", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [31, 0, 0]}, "expect": {"error": "hkl: use indices from −30 to 30."}},
    {"id": "f0a-params-coerce-miller-at-limit", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [30, -30, 1]}, "expect": {"value": [30, -30, 1]}},
    {"id": "f0a-params-coerce-miller-own-limit", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller", "max": 12}, "value": [-13, 0, 0]}, "expect": {"error": "hkl: use indices from −12 to 12."}},
    {"id": "f0a-params-coerce-miller-no-limit", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller", "max": null}, "value": [100, 0, 1]}, "expect": {"value": [100, 0, 1]}, "note": "a limit given as null is off"},
    {"id": "f0a-params-coerce-miller-decimal", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [1.5, 0, 0]}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-coerce-miller-bool", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [true, 0, 0]}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-coerce-miller-two", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": [1, 1]}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-coerce-miller-string", "op": "coerceParam", "args": {"spec": {"name": "hkl", "type": "miller"}, "value": "1 1 1"}, "expect": {"error": "hkl: enter three whole numbers (h k l) or four (h k i l), like 1 1 1."}},
    {"id": "f0a-params-coerce-miller-label", "op": "coerceParam", "args": {"spec": {"name": "miller", "type": "miller", "label": "Miller indices"}, "value": [0, 0, 0]}, "expect": {"error": "Miller indices: (0 0 0) is not a plane."}},
    {"id": "f0a-params-coerce-imatrix-flat", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "value": [2, 1, -1, 1]}, "expect": {"value": [[2, 1], [-1, 1]]}},
    {"id": "f0a-params-coerce-imatrix-identity", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "value": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]}, "expect": {"value": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]}},
    {"id": "f0a-params-coerce-imatrix-negative", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "value": [[0, 1, 0], [1, 0, 0], [0, 0, 1]]}, "expect": {"error": "P: the determinant is -1; a negative determinant mirrors the cell. Swap two rows or negate one."}},
    {"id": "f0a-params-coerce-imatrix-negative-allowed", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3, "positive": false}, "value": [[0, 1, 0], [1, 0, 0], [0, 0, 1]]}, "expect": {"value": [[0, 1, 0], [1, 0, 0], [0, 0, 1]]}},
    {"id": "f0a-params-coerce-imatrix-singular", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "value": [[1, 2, 3], [2, 4, 6], [0, 0, 1]]}, "expect": {"error": "P: the matrix is singular (determinant 0)."}},
    {"id": "f0a-params-coerce-imatrix-entries", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "value": [[51, 0, 0], [0, 1, 0], [0, 0, 1]]}, "expect": {"error": "P: use entries from −50 to 50."}},
    {"id": "f0a-params-coerce-imatrix-own-entries", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3, "max": 1000, "maxDet": 1000000.0}, "value": [[100, 0, 0], [0, 100, 0], [0, 0, 100]]}, "expect": {"value": [[100, 0, 0], [0, 100, 0], [0, 0, 100]]}, "note": "det 10⁶ = maxDet"},
    {"id": "f0a-params-coerce-imatrix-max-det", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3, "max": 1000, "maxDet": 1000000.0}, "value": [[101, 0, 0], [0, 100, 0], [0, 0, 100]]}, "expect": {"error": "P: determinant 1010000 is too large (at most 1000000)."}},
    {"id": "f0a-params-coerce-imatrix-no-max-det", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "value": [[41, 0], [0, 41]]}, "expect": {"value": [[41, 0], [0, 41]]}, "note": "p(41×41): no hard limit on the determinant by default (D12)"},
    {"id": "f0a-params-coerce-imatrix-whole", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "value": [[1.5, 0], [0, 1]]}, "expect": {"error": "P: every entry must be a whole number."}},
    {"id": "f0a-params-coerce-imatrix-ragged", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "value": [[1, 2], [3]]}, "expect": {"error": "P: enter a 2×2 matrix of whole numbers, rows separated by ';'."}},
    {"id": "f0a-params-coerce-imatrix-wrong-count", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "value": [1, 0, 0, 1]}, "expect": {"error": "P: enter a 3×3 matrix of whole numbers, rows separated by ';'."}},
    {"id": "f0a-params-coerce-imatrix-string", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 3}, "value": "1 0 0; 0 1 0; 0 0 1"}, "expect": {"error": "P: enter a 3×3 matrix of whole numbers, rows separated by ';'."}},
    {"id": "f0a-params-coerce-imatrix-bools", "op": "coerceParam", "args": {"spec": {"name": "P", "type": "imatrix", "size": 2}, "value": [[true, false], [false, true]]}, "expect": {"error": "P: enter a 2×2 matrix of whole numbers, rows separated by ';'."}},
    {"id": "f0a-params-validate-normalizes", "op": "validateParams", "args": {"schema": [{"name": "miller", "type": "miller", "label": "Miller indices"}, {"name": "layers", "type": "int", "label": "Layers", "min": 1, "default": 4}, {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "unit": "Å", "required": true}], "values": {"miller": [1, 0, -1, 0], "vacuum": 15}}, "expect": {"values": {"miller": [1, 0, 0], "layers": 4, "vacuum": 15}, "errors": [], "warnings": {"equals": []}}, "note": "four indices become three; a missing optional parameter takes its default"},
    {"id": "f0a-params-validate-required-missing", "op": "validateParams", "args": {"schema": [{"name": "miller", "type": "miller", "label": "Miller indices"}, {"name": "layers", "type": "int", "label": "Layers", "min": 1, "default": 4}, {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "unit": "Å", "required": true}], "values": {"miller": [1, 1, 1]}}, "expect": {"values": {"miller": [1, 1, 1], "layers": 4}, "errors": ["Vacuum: enter a value."], "warnings": {"equals": []}}, "note": "U4: the vacuum is never made up"},
    {"id": "f0a-params-validate-required-null", "op": "validateParams", "args": {"schema": [{"name": "miller", "type": "miller", "label": "Miller indices"}, {"name": "layers", "type": "int", "label": "Layers", "min": 1, "default": 4}, {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "unit": "Å", "required": true}], "values": {"miller": [1, 1, 1], "vacuum": null}}, "expect": {"values": {"miller": [1, 1, 1], "layers": 4}, "errors": ["Vacuum: enter a value."], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-strict-unknown", "op": "validateParams", "args": {"schema": [{"name": "miller", "type": "miller", "label": "Miller indices"}, {"name": "layers", "type": "int", "label": "Layers", "min": 1, "default": 4}, {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "unit": "Å", "required": true}], "values": {"hkl": [1, 1, 1], "vacuum": 10}, "strict": true, "title": "Cleave surface…"}, "expect": {"values": {"layers": 4, "vacuum": 10}, "errors": ["Cleave surface: unknown parameter “hkl” (use miller, layers, vacuum)."], "warnings": {"equals": []}}, "note": "the command title without its ellipsis; a missing optional parameter without a default is left out"},
    {"id": "f0a-params-validate-strict-ascii-ellipsis", "op": "validateParams", "args": {"schema": [{"name": "a", "type": "int"}], "values": {"b": 1}, "strict": true, "title": "Supercell..."}, "expect": {"values": {}, "errors": ["Supercell: unknown parameter “b” (use a)."], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-strict-no-title", "op": "validateParams", "args": {"schema": [{"name": "a", "type": "int"}], "values": {"b": 1}, "strict": true}, "expect": {"values": {}, "errors": ["Unknown parameter “b” (use a)."], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-strict-no-params", "op": "validateParams", "args": {"schema": [], "values": {"q": 1}, "strict": true, "title": "Reset view"}, "expect": {"values": {}, "errors": ["Reset view: unknown parameter “q” (it takes no parameters)."], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-strict-errors-order", "op": "validateParams", "args": {"schema": [{"name": "miller", "type": "miller", "label": "Miller indices"}, {"name": "layers", "type": "int", "label": "Layers", "min": 1, "default": 4}, {"name": "vacuum", "type": "float", "label": "Vacuum", "min": 0, "unit": "Å", "required": true}], "values": {"miller": [0, 0, 0], "x": 1}, "strict": true, "title": "Cleave surface…"}, "expect": {"values": {"layers": 4}, "errors": ["Cleave surface: unknown parameter “x” (use miller, layers, vacuum).", "Miller indices: (0 0 0) is not a plane.", "Vacuum: enter a value."], "warnings": {"equals": []}}, "note": "unknown keys first, then the fields in schema order"},
    {"id": "f0a-params-validate-loose-passes-unknown", "op": "validateParams", "args": {"schema": [{"name": "a", "type": "int"}], "values": {"a": 1, "zz": [1, "x"]}}, "expect": {"values": {"a": 1, "zz": [1, "x"]}, "errors": [], "warnings": {"equals": []}}, "note": "not strict (the REST plugin endpoints): undeclared keys pass unchanged"},
    {"id": "f0a-params-validate-defaults", "op": "validateParams", "args": {"schema": [{"name": "a", "type": "int", "default": 3}, {"name": "b", "type": "miller", "default": null}, {"name": "c", "type": "imatrix"}, {"name": "d", "type": "vector", "default": [0, 0, 1]}], "values": {}}, "expect": {"values": {"a": 3, "b": null, "d": [0, 0, 1]}, "errors": [], "warnings": {"equals": []}}, "note": "a null default is kept; no default: left out (nothing made up)"},
    {"id": "f0a-params-validate-null-is-missing", "op": "validateParams", "args": {"schema": [{"name": "a", "type": "int", "default": 3}], "values": {"a": null}}, "expect": {"values": {"a": 3}, "errors": [], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-warn-high-index", "op": "validateParams", "args": {"schema": [{"name": "hkl", "type": "miller"}], "values": {"hkl": [13, 0, 0]}}, "expect": {"values": {"hkl": [13, 0, 0]}, "errors": [], "warnings": {"equals": ["High-index plane; the surface cell may be large."]}}, "note": "above warnAbove = 12: a soft warning"},
    {"id": "f0a-params-validate-warn-high-index-off", "op": "validateParams", "args": {"schema": [{"name": "hkl", "type": "miller", "warnAbove": null}], "values": {"hkl": [13, 0, 0]}}, "expect": {"values": {"hkl": [13, 0, 0]}, "errors": [], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-warn-high-index-at", "op": "validateParams", "args": {"schema": [{"name": "hkl", "type": "miller"}], "values": {"hkl": [12, -12, 1]}}, "expect": {"values": {"hkl": [12, -12, 1]}, "errors": [], "warnings": {"equals": []}}},
    {"id": "f0a-params-validate-warn-det", "op": "validateParams", "args": {"schema": [{"name": "P", "type": "imatrix", "size": 2}], "values": {"P": [[30, 0], [0, 30]]}}, "expect": {"values": {"P": [[30, 0], [0, 30]]}, "errors": [], "warnings": {"equals": ["This makes 900× the atoms."]}}, "note": "p(30×30): above warnDet = 400"},
    {"id": "f0a-params-validate-warn-det-negative", "op": "validateParams", "args": {"schema": [{"name": "P", "type": "imatrix", "positive": false}], "values": {"P": [[0, 21, 0], [21, 0, 0], [0, 0, 1]]}}, "expect": {"values": {"P": [[0, 21, 0], [21, 0, 0], [0, 0, 1]]}, "errors": [], "warnings": {"equals": ["This makes 441× the atoms."]}}, "note": "|det| = 441"},
    {"id": "f0a-params-validate-warn-det-own", "op": "validateParams", "args": {"schema": [{"name": "P", "type": "imatrix", "warnDet": 1000}], "values": {"P": [[9, 0, 0], [0, 9, 0], [0, 0, 9]]}}, "expect": {"values": {"P": [[9, 0, 0], [0, 9, 0], [0, 0, 9]]}, "errors": [], "warnings": {"equals": []}}, "note": "det 729 ≤ warnDet 1000"},
    {"id": "f0a-params-validate-int-errors", "op": "validateParams", "args": {"schema": [{"name": "n", "type": "int", "label": "Atoms", "min": 1, "max": 10000}, {"name": "spacing", "type": "float", "label": "Spacing (Å)", "min": 0.5, "max": 10}], "values": {"n": 0, "spacing": "2"}}, "expect": {"values": {}, "errors": ["Atoms: use a value from 1 to 10000.", "Spacing (Å): enter a number."], "warnings": {"equals": []}}},
    {"id": "f0a-params-defaults-types", "op": "defaultParams", "args": {"schema": [{"name": "a", "type": "int", "min": 2}, {"name": "b", "type": "float"}, {"name": "c", "type": "bool"}, {"name": "d", "type": "element"}, {"name": "e", "type": "string"}, {"name": "f", "type": "select", "options": [["x", "X"], ["y", "Y"]]}, {"name": "g", "type": "vector"}, {"name": "h", "type": "vector", "size": 2}, {"name": "i", "type": "miller"}, {"name": "j", "type": "imatrix"}, {"name": "k", "type": "imatrix", "size": 2}, {"name": "l", "type": "color"}]}, "expect": {"value": {"a": 2, "b": 0, "c": false, "d": "C", "e": "", "f": "x", "g": [0, 0, 0], "h": [0, 0], "i": [1, 1, 1], "j": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "k": [[1, 0], [0, 1]], "l": ""}}, "note": "the default of each type"},
    {"id": "f0a-params-defaults-required", "op": "defaultParams", "args": {"schema": [{"name": "vacuum", "type": "float", "min": 0, "required": true}, {"name": "hkl", "type": "miller", "required": true}, {"name": "flag", "type": "bool", "required": true}, {"name": "kind", "type": "select", "options": ["fcc"], "required": true}]}, "expect": {"value": {"vacuum": null, "hkl": null, "flag": false, "kind": "fcc"}}, "note": "U4: a required parameter starts empty (not bool or select)"},
    {"id": "f0a-params-defaults-given", "op": "defaultParams", "args": {"schema": [{"name": "a", "type": "int", "min": 2, "default": 5}, {"name": "b", "type": "imatrix", "default": null}, {"name": "c", "type": "miller", "default": [1, 1, 0]}, {"name": "d", "type": "float", "required": true, "default": 1.5}, {"type": "int", "default": 1}]}, "expect": {"value": {"a": 5, "b": null, "c": [1, 1, 0], "d": 1.5}}, "note": "a default wins, also null; a parameter without a name is skipped"},
    {"id": "f0a-params-defaults-named", "op": "defaultParams", "args": {"schema": [{"name": 0, "type": "int"}, {"name": "", "type": "int", "default": 3}, {"name": null, "type": "int", "default": 4}]}, "expect": {"value": {"0": 0}}, "note": "a parameter is named when its name is neither null nor \"\" (0 is one), as in validateParams"},
    {"id": "f0a-params-validate-named", "op": "validateParams", "args": {"schema": [{"name": 0, "type": "int", "default": 1}, {"name": "", "type": "int", "default": 3}], "values": {}}, "expect": {"values": {"0": 1}, "errors": [], "warnings": {"equals": []}}},
    {"id": "f0a-params-defaults-schema-not-list", "op": "defaultParams", "args": {"schema": {"name": "a", "type": "int"}}, "expect": {"error": "schema must be a list"}, "note": "a TypeError in both languages"},
    {"id": "f0a-params-validate-schema-not-list", "op": "validateParams", "args": {"schema": {"name": "a", "type": "int"}, "values": {}}, "expect": {"error": "schema must be a list"}, "note": "a TypeError in both languages"}
  ]
}
